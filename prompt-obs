#!/bin/sh
# Paint the face into OBS. Leave OBS open, with the websocket server enabled.
cd "$(dirname "$0")" || exit 1
if [ ! -x ./venv/bin/python ]; then
  echo "No virtual environment yet. Follow the install steps in README.md."
  printf "Press Enter to close. "
  read _ || true
  exit 1
fi
./venv/bin/python -m face_state.obs_bridge "$@"
status=$?
if [ "$status" -ne 0 ] && [ "$status" -ne 130 ]; then
  printf "Press Enter to close. "
  read _ || true
fi
exit "$status"
