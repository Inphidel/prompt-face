#!/bin/sh
# Start the webcam tracker in this project directory.
cd "$(dirname "$0")" || exit 1
if [ ! -x ./venv/bin/python ]; then
  echo "No virtual environment yet. Follow the install steps in README.md."
  printf "Press Enter to close. "
  read _ || true
  exit 1
fi
if [ ! -f ./config.json ]; then
  echo "config.json is missing. Copy config.example.json to config.json and edit the camera."
fi
./venv/bin/python -m face_state "$@"
status=$?
if [ "$status" -ne 0 ] && [ "$status" -ne 130 ]; then
  printf "Press Enter to close. "
  read _ || true
fi
exit "$status"
